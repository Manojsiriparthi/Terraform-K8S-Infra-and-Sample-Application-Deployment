---
# ============================================================================
# 7. PRODUCT CATALOG SERVICE (Go/gRPC/3550) - Connects to PostgreSQL
# ============================================================================
apiVersion: apps/v1
kind: Deployment
metadata:
  name: productcatalogservice
  namespace: application
  labels:
    app: productcatalogservice
    tier: backend
    language: go
spec:
  replicas: 2
  selector:
    matchLabels:
      app: productcatalogservice
  template:
    metadata:
      labels:
        app: productcatalogservice
        tier: backend
    spec:
      nodeSelector:
        node-type: general
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        fsGroup: 1000
      containers:
        - name: productcatalogservice
          image: 605855663470.dkr.ecr.us-east-1.amazonaws.com/shopease-dev-productcatalogservice:fc3c662
          imagePullPolicy: Always
          ports:
            - containerPort: 3550
              name: grpc
          env:
            - name: PORT
              value: "3550"
            # PostgreSQL database connection for products
            - name: DATABASE_URL
              value: "postgresql://shopease:shopease123@postgres-service:5432/shopease"
            - name: DB_HOST
              value: "postgres-service"
            - name: DB_PORT
              value: "5432"
            - name: DB_NAME
              value: "shopease"
            - name: DB_USER
              value: "shopease"
            - name: DB_PASSWORD
              value: "shopease123"
            - name: DISABLE_PROFILER
              value: "1"
          resources:
            requests:
              cpu: 100m
              memory: 64Mi
            limits:
              cpu: 200m
              memory: 128Mi
          livenessProbe:
            grpc:
              port: 3550
            initialDelaySeconds: 20
            periodSeconds: 15
          readinessProbe:
            grpc:
              port: 3550
            initialDelaySeconds: 10
            periodSeconds: 10
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
            readOnlyRootFilesystem: true
---
apiVersion: v1
kind: Service
metadata:
  name: productcatalogservice
  namespace: application
  labels:
    app: productcatalogservice
spec:
  type: ClusterIP
  selector:
    app: productcatalogservice
  ports:
    - name: grpc
      port: 3550
      targetPort: 3550

---
# ============================================================================
# 8. RECOMMENDATION SERVICE (Python/gRPC/8080)
# ============================================================================
apiVersion: apps/v1
kind: Deployment
metadata:
  name: recommendationservice
  namespace: application
  labels:
    app: recommendationservice
    tier: backend
    language: python
spec:
  replicas: 2
  selector:
    matchLabels:
      app: recommendationservice
  template:
    metadata:
      labels:
        app: recommendationservice
        tier: backend
    spec:
      nodeSelector:
        node-type: general
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        fsGroup: 1000
      containers:
        - name: recommendationservice
          image: 605855663470.dkr.ecr.us-east-1.amazonaws.com/shopease-dev-recommendationservice:fc3c662
          imagePullPolicy: Always
          ports:
            - containerPort: 8080
              name: grpc
          env:
            - name: PORT
              value: "8080"
            - name: PRODUCT_CATALOG_SERVICE_ADDR
              value: "productcatalogservice:3550"
            - name: DISABLE_PROFILER
              value: "1"
          resources:
            requests:
              cpu: 100m
              memory: 220Mi
            limits:
              cpu: 200m
              memory: 450Mi
          livenessProbe:
            grpc:
              port: 8080
            initialDelaySeconds: 20
            periodSeconds: 15
          readinessProbe:
            grpc:
              port: 8080
            initialDelaySeconds: 10
            periodSeconds: 10
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
            readOnlyRootFilesystem: true
---
apiVersion: v1
kind: Service
metadata:
  name: recommendationservice
  namespace: application
  labels:
    app: recommendationservice
spec:
  type: ClusterIP
  selector:
    app: recommendationservice
  ports:
    - name: grpc
      port: 8080
      targetPort: 8080

