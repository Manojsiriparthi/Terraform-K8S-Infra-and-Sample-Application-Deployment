---
# ============================================================================
# ALL BACKEND SERVICES - PRODUCTION DEPLOYMENT
# ============================================================================
# This file contains all 9 backend microservices in a single file
# Production best practice: Single file for easier version control and deployment
#
# Database Connection:
# - All services can connect to PostgreSQL using: postgres-service:5432
# - Connection string: postgresql://shopease:shopease123@postgres-service:5432/shopease
# - Product Catalog Service uses database for products
# - Checkout Service can store orders in database
#
# Services included:
# 1. adservice (Java/9555)
# 2. cartservice (C#/7070) - Connects to Redis
# 3. checkoutservice (Go/5050)
# 4. currencyservice (Node.js/7000)
# 5. emailservice (Python/8080)
# 6. paymentservice (Node.js/50051)
# 7. productcatalogservice (Go/3550) - Connects to PostgreSQL
# 8. recommendationservice (Python/8080)
# 9. shippingservice (Go/50051)
# ============================================================================

---
# ============================================================================
# 1. AD SERVICE (Java/gRPC/9555)
# ============================================================================
apiVersion: apps/v1
kind: Deployment
metadata:
  name: adservice
  namespace: application
  labels:
    app: adservice
    tier: backend
    language: java
spec:
  replicas: 2
  selector:
    matchLabels:
      app: adservice
  template:
    metadata:
      labels:
        app: adservice
        tier: backend
    spec:
      nodeSelector:
        node-type: general
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        fsGroup: 1000
      containers:
        - name: adservice
          image: 605855663470.dkr.ecr.us-east-1.amazonaws.com/shopease-dev-adservice:fc3c662
          imagePullPolicy: Always
          ports:
            - containerPort: 9555
              name: grpc
          env:
            - name: PORT
              value: "9555"
            - name: DISABLE_PROFILER
              value: "1"
          resources:
            requests:
              cpu: 200m
              memory: 180Mi
            limits:
              cpu: 300m
              memory: 300Mi
          livenessProbe:
            grpc:
              port: 9555
            initialDelaySeconds: 20
            periodSeconds: 15
          readinessProbe:
            grpc:
              port: 9555
            initialDelaySeconds: 10
            periodSeconds: 10
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
            readOnlyRootFilesystem: true
---
apiVersion: v1
kind: Service
metadata:
  name: adservice
  namespace: application
  labels:
    app: adservice
spec:
  type: ClusterIP
  selector:
    app: adservice
  ports:
    - name: grpc
      port: 9555
      targetPort: 9555

---
# ============================================================================
# 2. CART SERVICE (C#/gRPC/7070) - Connects to Redis
# ============================================================================
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cartservice
  namespace: application
  labels:
    app: cartservice
    tier: backend
    language: csharp
spec:
  replicas: 2
  selector:
    matchLabels:
      app: cartservice
  template:
    metadata:
      labels:
        app: cartservice
        tier: backend
    spec:
      nodeSelector:
        node-type: general
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        fsGroup: 1000
      containers:
        - name: cartservice
          image: 605855663470.dkr.ecr.us-east-1.amazonaws.com/shopease-dev-cartservice:fc3c662
          imagePullPolicy: Always
          ports:
            - containerPort: 7070
              name: grpc
          env:
            - name: PORT
              value: "7070"
            # Redis connection for cart cache
            - name: REDIS_ADDR
              value: "redis-cart:6379"
            - name: DISABLE_PROFILER
              value: "1"
          resources:
            requests:
              cpu: 200m
              memory: 160Mi
            limits:
              cpu: 300m
              memory: 256Mi
          livenessProbe:
            grpc:
              port: 7070
            initialDelaySeconds: 20
            periodSeconds: 15
          readinessProbe:
            grpc:
              port: 7070
            initialDelaySeconds: 10
            periodSeconds: 10
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
            readOnlyRootFilesystem: true
---
apiVersion: v1
kind: Service
metadata:
  name: cartservice
  namespace: application
  labels:
    app: cartservice
spec:
  type: ClusterIP
  selector:
    app: cartservice
  ports:
    - name: grpc
      port: 7070
      targetPort: 7070

---
# ============================================================================
# 3. CHECKOUT SERVICE (Go/gRPC/5050)
# ============================================================================
apiVersion: apps/v1
kind: Deployment
metadata:
  name: checkoutservice
  namespace: application
  labels:
    app: checkoutservice
    tier: backend
    language: go
spec:
  replicas: 2
  selector:
    matchLabels:
      app: checkoutservice
  template:
    metadata:
      labels:
        app: checkoutservice
        tier: backend
    spec:
      nodeSelector:
        node-type: general
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        fsGroup: 1000
      containers:
        - name: checkoutservice
          image: 605855663470.dkr.ecr.us-east-1.amazonaws.com/shopease-dev-checkoutservice:fc3c662
          imagePullPolicy: Always
          ports:
            - containerPort: 5050
              name: grpc
          env:
            - name: PORT
              value: "5050"
            # Backend service connections
            - name: PRODUCT_CATALOG_SERVICE_ADDR
              value: "productcatalogservice:3550"
            - name: SHIPPING_SERVICE_ADDR
              value: "shippingservice:50051"
            - name: PAYMENT_SERVICE_ADDR
              value: "paymentservice:50051"
            - name: EMAIL_SERVICE_ADDR
              value: "emailservice:8080"
            - name: CURRENCY_SERVICE_ADDR
              value: "currencyservice:7000"
            - name: CART_SERVICE_ADDR
              value: "cartservice:7070"
            # Optional: Database connection for storing orders
            - name: DATABASE_URL
              value: "postgresql://shopease:shopease123@postgres-service:5432/shopease"
            - name: DISABLE_PROFILER
              value: "1"
          resources:
            requests:
              cpu: 100m
              memory: 64Mi
            limits:
              cpu: 200m
              memory: 128Mi
          livenessProbe:
            grpc:
              port: 5050
            initialDelaySeconds: 20
            periodSeconds: 15
          readinessProbe:
            grpc:
              port: 5050
            initialDelaySeconds: 10
            periodSeconds: 10
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
            readOnlyRootFilesystem: true
---
apiVersion: v1
kind: Service
metadata:
  name: checkoutservice
  namespace: application
  labels:
    app: checkoutservice
spec:
  type: ClusterIP
  selector:
    app: checkoutservice
  ports:
    - name: grpc
      port: 5050
      targetPort: 5050

---
