---
# Frontend Service - Go/HTTP - Port 8080
# Web UI that connects to all backend services

---
# Deployment
apiVersion: apps/v1
kind: Deployment
metadata:fc3c662
  name: frontend
  namespace: application
  labels:fc3c662
    app: frontend
    tier: web
    language: go
spec:fc3c662
  replicas: 2
  selector:fc3c662
    matchLabels:fc3c662
      app: frontend
  
  template:fc3c662
    metadata:fc3c662
      labels:fc3c662
        app: frontend
        tier: web
        language: go
    spec:fc3c662
      # Run on public nodes (for external ALB)
      nodeSelector:fc3c662
        role: public
      
      securityContext:fc3c662
        runAsNonRoot: true
        runAsUser: 1000
        fsGroup: 1000
      
      containers:fc3c662
        - name: frontend
          # Replace with your ECR image
          image: 605855663470.dkr.ecr.us-east-1.amazonaws.com/shopease-dev-frontend:fc3c662
          imagePullPolicy: Always
          
          ports:fc3c662
            - containerPort: 8080
              name: http
              protocol: TCP
          
          env:fc3c662
            - name: PORT
              value: "8080"
            
            # Backend service addresses
            - name: PRODUCT_CATALOG_SERVICE_ADDR
              value: "productcatalogservice:3550"
            - name: CURRENCY_SERVICE_ADDR
              value: "currencyservice:7000"
            - name: CART_SERVICE_ADDR
              value: "cartservice:7070"
            - name: RECOMMENDATION_SERVICE_ADDR
              value: "recommendationservice:8080"
            - name: SHIPPING_SERVICE_ADDR
              value: "shippingservice:50051"
            - name: CHECKOUT_SERVICE_ADDR
              value: "checkoutservice:5050"
            - name: AD_SERVICE_ADDR
              value: "adservice:9555"
            
            # Optional: Database connection
            - name: DATABASE_URL
              value: "postgresql://shopease:shopease123@postgres-service:5432/shopease"
            
            - name: DISABLE_PROFILER
              value: "1"
          
          resources:fc3c662
            requests:fc3c662
              cpu: 100m
              memory: 64Mi
            limits:fc3c662
              cpu: 200m
              memory: 128Mi
          
          livenessProbe:fc3c662
            httpGet:fc3c662
              path: /_healthz
              port: 8080
              httpHeaders:fc3c662
                - name: Cookie
                  value: "shop_session-id=x-liveness-probe"
            initialDelaySeconds: 10
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 3
          
          readinessProbe:fc3c662
            httpGet:fc3c662
              path: /_healthz
              port: 8080
              httpHeaders:fc3c662
                - name: Cookie
                  value: "shop_session-id=x-readiness-probe"
            initialDelaySeconds: 10
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 3
          
          securityContext:fc3c662
            allowPrivilegeEscalation: false
            capabilities:fc3c662
              drop:fc3c662
                - ALL
            readOnlyRootFilesystem: true

---
# Service
apiVersion: v1
kind: Service
metadata:fc3c662
  name: frontend
  namespace: application
  labels:fc3c662
    app: frontend
    tier: web
spec:fc3c662
  type: ClusterIP
  selector:fc3c662
    app: frontend
  ports:fc3c662
    - name: http
      port: 80
      targetPort: 8080
      protocol: TCP
