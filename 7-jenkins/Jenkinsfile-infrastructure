pipeline {
    agent any
    
    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'qa', 'prod'],
            description: 'Select environment to deploy'
        )
        choice(
            name: 'ACTION',
            choices: ['plan', 'apply', 'destroy'],
            description: 'Terraform action'
        )
        string(
            name: 'AWS_REGION',
            defaultValue: 'us-east-1',
            description: 'AWS Region'
        )
    }
    
    environment {
        AWS_REGION = "${params.AWS_REGION}"
        ENVIRONMENT = "${params.ENVIRONMENT}"
        TF_VAR_environment = "${params.ENVIRONMENT}"
        TF_VAR_aws_region = "${params.AWS_REGION}"
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Validate Prerequisites') {
            steps {
                script {
                    sh '''
                        terraform version
                        aws --version
                        aws sts get-caller-identity
                    '''
                }
            }
        }
        
        stage('Layer 1: Infrastructure') {
            steps {
                script {
                    dir('1-infrastructure') {
                        sh '''
                            terraform init -upgrade
                            terraform workspace select ${ENVIRONMENT} || terraform workspace new ${ENVIRONMENT}
                        '''
                        
                        if (params.ACTION == 'plan') {
                            sh 'terraform plan -out=tfplan'
                        } else if (params.ACTION == 'apply') {
                            sh '''
                                terraform plan -out=tfplan
                                terraform apply -auto-approve tfplan
                                rm -f tfplan
                            '''
                        } else if (params.ACTION == 'destroy') {
                            sh 'terraform destroy -auto-approve'
                        }
                    }
                }
            }
        }
        
        stage('Layer 2: EKS Addons') {
            when {
                expression { params.ACTION != 'destroy' }
            }
            steps {
                script {
                    dir('2-eks-addons') {
                        sh '''
                            terraform init -upgrade
                            terraform workspace select ${ENVIRONMENT} || terraform workspace new ${ENVIRONMENT}
                        '''
                        
                        if (params.ACTION == 'plan') {
                            sh 'terraform plan -out=tfplan'
                        } else if (params.ACTION == 'apply') {
                            sh '''
                                terraform plan -out=tfplan
                                terraform apply -auto-approve tfplan
                                rm -f tfplan
                            '''
                        }
                    }
                }
            }
        }
        
        stage('Configure kubectl') {
            when {
                expression { params.ACTION == 'apply' }
            }
            steps {
                script {
                    sh '''
                        CLUSTER_NAME=$(cd 1-infrastructure && terraform output -raw cluster_name)
                        aws eks update-kubeconfig --region ${AWS_REGION} --name ${CLUSTER_NAME}
                        kubectl cluster-info
                    '''
                }
            }
        }
        
        stage('Destroy Layer 2') {
            when {
                expression { params.ACTION == 'destroy' }
            }
            steps {
                script {
                    dir('2-eks-addons') {
                        sh 'terraform destroy -auto-approve'
                    }
                }
            }
        }
    }
    
    post {
        success {
            echo "Infrastructure ${params.ACTION} completed successfully for ${params.ENVIRONMENT}"
        }
        failure {
            echo "Infrastructure ${params.ACTION} failed for ${params.ENVIRONMENT}"
        }
        always {
            cleanWs()
        }
    }
}
