pipeline {
    agent any
    
    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'qa', 'prod'],
            description: 'Select environment'
        )
        string(
            name: 'AWS_REGION',
            defaultValue: 'us-east-1',
            description: 'AWS Region'
        )
        string(
            name: 'IMAGE_TAG',
            defaultValue: 'latest',
            description: 'Docker image tag'
        )
        booleanParam(
            name: 'SKIP_TESTS',
            defaultValue: false,
            description: 'Skip application tests'
        )
        booleanParam(
            name: 'DEPLOY_MONITORING',
            defaultValue: true,
            description: 'Deploy monitoring stack'
        )
    }
    
    environment {
        AWS_REGION = "${params.AWS_REGION}"
        ENVIRONMENT = "${params.ENVIRONMENT}"
        IMAGE_TAG = "${params.IMAGE_TAG}"
        AWS_ACCOUNT_ID = sh(script: 'aws sts get-caller-identity --query Account --output text', returnStdout: true).trim()
        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Test Backend') {
            when {
                expression { !params.SKIP_TESTS }
            }
            steps {
                dir('3-application/backend') {
                    sh '''
                        python3 -m pip install -r requirements.txt
                        python3 -m pytest tests/ || echo "No tests found"
                    '''
                }
            }
        }
        
        stage('Test Frontend') {
            when {
                expression { !params.SKIP_TESTS }
            }
            steps {
                dir('3-application/frontend') {
                    sh '''
                        npm install
                        npm run build
                    '''
                }
            }
        }
        
        stage('Build & Push Docker Images') {
            steps {
                script {
                    // Create ECR repos
                    sh '''
                        aws ecr describe-repositories --repository-names shopease-frontend --region ${AWS_REGION} 2>/dev/null || \
                            aws ecr create-repository --repository-name shopease-frontend --region ${AWS_REGION}
                        
                        aws ecr describe-repositories --repository-names shopease-backend --region ${AWS_REGION} 2>/dev/null || \
                            aws ecr create-repository --repository-name shopease-backend --region ${AWS_REGION}
                    '''
                    
                    // Login to ECR
                    sh 'aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}'
                    
                    // Build and push frontend
                    dir('3-application/frontend') {
                        sh '''
                            docker build -t shopease-frontend:${IMAGE_TAG} .
                            docker tag shopease-frontend:${IMAGE_TAG} ${ECR_REGISTRY}/shopease-frontend:${IMAGE_TAG}
                            docker push ${ECR_REGISTRY}/shopease-frontend:${IMAGE_TAG}
                        '''
                    }
                    
                    // Build and push backend
                    dir('3-application/backend') {
                        sh '''
                            docker build -t shopease-backend:${IMAGE_TAG} .
                            docker tag shopease-backend:${IMAGE_TAG} ${ECR_REGISTRY}/shopease-backend:${IMAGE_TAG}
                            docker push ${ECR_REGISTRY}/shopease-backend:${IMAGE_TAG}
                        '''
                    }
                }
            }
        }
        
        stage('Update Manifests') {
            steps {
                sh '''
                    sed -i "s|<AWS_ACCOUNT_ID>|${AWS_ACCOUNT_ID}|g" 4-kubernetes-manifests/backend.yaml
                    sed -i "s|<REGION>|${AWS_REGION}|g" 4-kubernetes-manifests/backend.yaml
                    sed -i "s|latest|${IMAGE_TAG}|g" 4-kubernetes-manifests/backend.yaml
                    
                    sed -i "s|<AWS_ACCOUNT_ID>|${AWS_ACCOUNT_ID}|g" 4-kubernetes-manifests/frontend.yaml
                    sed -i "s|<REGION>|${AWS_REGION}|g" 4-kubernetes-manifests/frontend.yaml
                    sed -i "s|latest|${IMAGE_TAG}|g" 4-kubernetes-manifests/frontend.yaml
                '''
            }
        }
        
        stage('Configure kubectl') {
            steps {
                sh '''
                    CLUSTER_NAME=$(cd 1-infrastructure && terraform workspace select ${ENVIRONMENT} && terraform output -raw cluster_name)
                    aws eks update-kubeconfig --region ${AWS_REGION} --name ${CLUSTER_NAME}
                '''
            }
        }
        
        stage('Deploy Application') {
            steps {
                sh '''
                    kubectl apply -f 4-kubernetes-manifests/namespaces.yaml
                    kubectl apply -f 4-kubernetes-manifests/rbac.yaml
                    kubectl apply -f 4-kubernetes-manifests/storage.yaml
                    kubectl apply -f 4-kubernetes-manifests/database.yaml
                    
                    echo "Waiting for database..."
                    kubectl wait --for=condition=ready pod -l app=postgres -n application --timeout=300s || true
                    
                    kubectl apply -f 4-kubernetes-manifests/backend.yaml
                    kubectl apply -f 4-kubernetes-manifests/frontend.yaml
                    kubectl apply -f 4-kubernetes-manifests/hpa.yaml
                    kubectl apply -f 4-kubernetes-manifests/network-policies.yaml
                '''
            }
        }
        
        stage('Deploy Monitoring') {
            when {
                expression { params.DEPLOY_MONITORING }
            }
            steps {
                dir('6-monitoring') {
                    sh '''
                        chmod +x install-monitoring.sh
                        ./install-monitoring.sh
                    '''
                }
            }
        }
        
        stage('Verify Deployment') {
            steps {
                sh '''
                    kubectl get all -n application
                    kubectl get ingress -n application
                    
                    echo "Waiting for pods to be ready..."
                    kubectl wait --for=condition=ready pod -l app=backend -n application --timeout=300s
                    kubectl wait --for=condition=ready pod -l app=frontend -n application --timeout=300s
                '''
            }
        }
    }
    
    post {
        success {
            script {
                def frontendUrl = sh(script: "kubectl get ingress frontend-ingress -n application -o jsonpath='{.status.loadBalancer.ingress[0].hostname}'", returnStdout: true).trim()
                def backendUrl = sh(script: "kubectl get ingress backend-ingress -n application -o jsonpath='{.status.loadBalancer.ingress[0].hostname}'", returnStdout: true).trim()
                
                echo """
                ==========================================
                Deployment Successful!
                ==========================================
                Environment: ${params.ENVIRONMENT}
                Image Tag: ${params.IMAGE_TAG}
                
                Frontend URL: http://${frontendUrl}
                Backend URL: http://${backendUrl}
                
                Check status:
                  kubectl get all -n application
                ==========================================
                """
            }
        }
        failure {
            echo "Deployment failed for ${params.ENVIRONMENT}"
        }
    }
}
